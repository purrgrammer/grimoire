{
  "name": "grimoire",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css}\"",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "generate-icons": "node scripts/generate-pwa-icons.mjs",
    "android:icons": "node scripts/generate-android-icons.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:build:debug": "node scripts/android/build.mjs debug",
    "android:build:release": "node scripts/android/build.mjs release",
    "android:test": "cd android && ./gradlew --no-daemon testDebugUnitTest lintDebug",
    "android:verify": "scripts/android/verify-apk.sh"
  },
